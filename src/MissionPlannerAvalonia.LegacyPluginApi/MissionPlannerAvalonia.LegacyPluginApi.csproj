<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MissionPlanner</AssemblyName>
    <RootNamespace>MissionPlanner</RootNamespace>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <MissionPlannerVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../external/MissionPlanner/Properties/AssemblyInfo.cs'))</MissionPlannerVersionFile>
    <MissionPlannerVersionFileExists>$([System.IO.File]::Exists('$(MissionPlannerVersionFile)'))</MissionPlannerVersionFileExists>
    <MissionPlannerUpstreamVersion Condition="'$(MissionPlannerUpstreamVersion)' == '' And '$(MissionPlannerVersionFileExists)' == 'True'">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MissionPlannerVersionFile)')), 'AssemblyFileVersion\(&quot;([0-9]+\.[0-9]+\.[0-9]+)&quot;\)').Groups[1].Value)</MissionPlannerUpstreamVersion>
    <MissionPlannerUpstreamVersion Condition="'$(MissionPlannerUpstreamVersion)' == ''">0.0.0</MissionPlannerUpstreamVersion>
    <Version>$(MissionPlannerUpstreamVersion)</Version>
    <FileVersion>$(MissionPlannerUpstreamVersion).0</FileVersion>
    <Description>Binary compatibility contract for non-WinForms Mission Planner plugins.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MissionPlannerAvalonia.PluginApi/MissionPlannerAvalonia.PluginApi.csproj">
      <Aliases>PortablePluginContract</Aliases>
    </ProjectReference>
    <ProjectReference Include="../../external/MissionPlanner/ExtLibs/ArduPilot/MissionPlanner.ArduPilot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MissionPlannerAvalonia" />
    <InternalsVisibleTo Include="MissionPlannerAvalonia.Tests" />
  </ItemGroup>
</Project>
