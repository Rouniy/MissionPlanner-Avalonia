<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:MissionPlannerAvalonia.ViewModels"
  mc:Ignorable="d"
  d:DesignWidth="680"
  d:DesignHeight="430"
  x:Class="MissionPlannerAvalonia.Views.TrackerHomeModuleWindow"
  x:DataType="vm:TrackerHomeModuleViewModel"
  Title="Tracker Home — Obtain From Module"
  Width="680" Height="430" MinWidth="560" MinHeight="360"
  WindowStartupLocation="CenterOwner">
  <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="9">
    <TextBlock Grid.Row="0" TextWrapping="Wrap"
               Text="Read one validated NMEA GGA fix from an external GPS. The device is released immediately after the fix; tracker altitude is resolved from local terrain data after this window closes." />

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Grid.Column="0" Text="Source" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Inputs}"
                SelectedItem="{Binding SelectedInput, Mode=TwoWay}"
                IsEnabled="{Binding CanEditSettings}" />
      <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshInputsCommand}"
              IsEnabled="{Binding CanEditSettings}" />
      <ComboBox Grid.Column="3" Width="105" ItemsSource="{Binding Bauds}"
                SelectedItem="{Binding SelectedBaud, Mode=TwoWay}"
                IsVisible="{Binding IsSerialInput}" IsEnabled="{Binding CanEditSettings}" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8"
          IsVisible="{Binding IsNetworkInput}">
      <TextBlock Grid.Column="0" Text="Host" VerticalAlignment="Center"
                 IsVisible="{Binding NeedsHost}" />
      <TextBox Grid.Column="1" Text="{Binding NetworkHost, Mode=TwoWay}"
               IsVisible="{Binding NeedsHost}" IsEnabled="{Binding CanEditSettings}" />
      <TextBlock Grid.Column="2" Text="{Binding PortLabel}" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="3" Minimum="1" Maximum="65535"
                     Value="{Binding NetworkPort, Mode=TwoWay}"
                     IsEnabled="{Binding CanEditSettings}" />
    </Grid>

    <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="4">
      <TextBlock Grid.Row="0" Text="{Binding Status}" TextWrapping="Wrap"
                 FontWeight="SemiBold" />
      <TextBox Grid.Row="1" Text="{Binding RawNmea}" AcceptsReturn="True"
               IsReadOnly="True" TextWrapping="NoWrap" FontFamily="monospace"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelTrackerHomeButton" Content="Close" MinWidth="90"
              IsCancel="True" Click="OnCancelClick" />
      <Button x:Name="ObtainTrackerHomeButton" Content="{Binding ReadButtonText}"
              Command="{Binding ObtainCommand}" MinWidth="110" />
    </StackPanel>
  </Grid>
</Window>
