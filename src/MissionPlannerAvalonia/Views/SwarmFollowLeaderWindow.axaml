<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:MissionPlannerAvalonia.ViewModels"
  x:Class="MissionPlannerAvalonia.Views.SwarmFollowLeaderWindow"
  x:DataType="vm:SwarmFollowLeaderViewModel"
  Title="Swarm Follow Leader (Beta)"
  Width="1240"
  Height="720"
  MinWidth="980"
  MinHeight="600"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource MpControlBg}">
  <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10">
    <Border Grid.Row="0" Background="#5A2B20" BorderBrush="#FF9B66" BorderThickness="1"
            CornerRadius="4" Padding="10">
      <TextBlock Foreground="#FFD4B8" TextWrapping="Wrap"
                 Text="BETA / USE AT OWN RISK — port of official Mission Planner FollowLeader. The ground master is observed only. The selected ArduCopter air master and followers receive position/velocity targets at 10 Hz. A stale, missing or replacement modem/vehicle, GPS jump, role edit or incomplete group validation stops the complete command stream." />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,300,Auto,300,Auto,*" ColumnSpacing="8">
      <TextBlock Text="Ground master" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Vehicles}"
                SelectedItem="{Binding SelectedGroundMaster, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:WaypointLeaderVehicleItem">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Grid.Column="2" Text="Air master" VerticalAlignment="Center" />
      <ComboBox Grid.Column="3" ItemsSource="{Binding Vehicles}"
                SelectedItem="{Binding SelectedAirMaster, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:WaypointLeaderVehicleItem">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="4" Content="Refresh Vehicles" Command="{Binding RefreshCommand}" />
      <TextBlock Grid.Column="5" Margin="8,0,0,0" VerticalAlignment="Center"
                 Text="Ground master may be any autopilot; commanded air roles require ArduCopter."
                 TextWrapping="Wrap" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,95,Auto,95,Auto,95,Auto,95,*"
          ColumnSpacing="8">
      <TextBlock Text="Separation m" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="1" Value="{Binding SeparationM, Mode=TwoWay}"
                     Minimum="1" Maximum="500" Increment="1" FormatString="0.0" />
      <TextBlock Grid.Column="2" Text="Lead m" VerticalAlignment="Center"
                 ToolTip.Tip="Retained for parity: official FollowLeader exposes this value but does not use it in UpdatePositions." />
      <NumericUpDown Grid.Column="3" Value="{Binding LeadM, Mode=TwoWay}"
                     Minimum="-100000" Maximum="100000" Increment="1" FormatString="0.0"
                     ToolTip.Tip="Upstream-reserved setting; currently has no flight effect in official Mission Planner." />
      <TextBlock Grid.Column="4" Text="Flight altitude m" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="5" Value="{Binding AltitudeM, Mode=TwoWay}"
                     Minimum="1" Maximum="10000" Increment="1" FormatString="0.0" />
      <TextBlock Grid.Column="6" Text="Takeoff m" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="7" Value="{Binding TakeoffAltitudeM, Mode=TwoWay}"
                     Minimum="1" Maximum="10000" Increment="1" FormatString="0.0" />
      <TextBlock Grid.Column="8" Margin="10,0,0,0" VerticalAlignment="Center"
                 Text="Follower #1 follows the current ground position; later followers occupy Separation-spaced trail points."
                 TextWrapping="Wrap" />
    </Grid>

    <DataGrid x:Name="FollowLeaderVehicleGrid" Grid.Row="3" ItemsSource="{Binding Vehicles}"
              AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
              CanUserReorderColumns="False">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Use" Binding="{Binding Included, Mode=TwoWay}"
                                Width="50" />
        <DataGridTextColumn Header="Order" Binding="{Binding Order, Mode=TwoWay}"
                            Width="65" />
        <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" IsReadOnly="True"
                            Width="170" />
        <DataGridTextColumn Header="Sys" Binding="{Binding SystemId}" IsReadOnly="True"
                            Width="48" />
        <DataGridTextColumn Header="Comp" Binding="{Binding ComponentId}" IsReadOnly="True"
                            Width="54" />
        <DataGridTextColumn Header="Role" Binding="{Binding Role}" IsReadOnly="True"
                            Width="145" />
        <DataGridTextColumn Header="Firmware" Binding="{Binding Firmware}" IsReadOnly="True"
                            Width="110" />
        <DataGridTextColumn Header="Live status" Binding="{Binding LiveStatus}" IsReadOnly="True"
                            Width="220" />
        <DataGridTextColumn Header="Current commanded target" Binding="{Binding Target}"
                            IsReadOnly="True" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8"
          IsEnabled="{Binding !Busy}">
      <Button x:Name="FollowLeaderRunButton" Content="{Binding RunButtonText}"
              Command="{Binding ToggleRunCommand}" MinWidth="165" />
      <Button Grid.Column="1" Content="Arm Air Group" Command="{Binding ArmAirGroupCommand}" />
      <Button Grid.Column="2" Content="Disarm Air Group"
              Command="{Binding DisarmAirGroupCommand}" />
      <Button Grid.Column="3" Content="Take Off" Command="{Binding TakeoffAirGroupCommand}" />
      <Button Grid.Column="4" Content="GUIDED" Command="{Binding GuidedAirGroupCommand}" />
      <Button Grid.Column="5" Content="NAV GUIDED"
              Command="{Binding NavGuidedAirGroupCommand}" />
      <Button Grid.Column="6" Content="AUTO All Roles" Command="{Binding AutoAllRolesCommand}"
              HorizontalAlignment="Left" />
    </Grid>

    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"
                 Foreground="{DynamicResource MpAccentBrush}" />
      <Button Grid.Column="1" Content="Close" Click="OnClose" MinWidth="90" />
    </Grid>
  </Grid>
</Window>
