<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:MissionPlannerAvalonia.ViewModels"
  mc:Ignorable="d"
  d:DesignWidth="560"
  d:DesignHeight="470"
  x:Class="MissionPlannerAvalonia.Views.MovingBaseView"
  x:DataType="vm:MovingBaseViewModel"
  Background="{DynamicResource MpControlBg}"
>
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="Moving Base" FontSize="18" Foreground="#DDD" />
    <TextBlock
      Foreground="#AAA"
      TextWrapping="Wrap"
      Text="Reads GGA positions from an external NMEA GPS and shows the moving base on Flight Data. The session is bound to the exact selected modem/system/component and stops after a selection change. Optional Plane Rally Point 0 writes require a separate reject-by-default confirmation."
    />
    <TextBlock Text="{Binding TargetDescription}" Foreground="{DynamicResource MpAccentBrush}"
               TextWrapping="Wrap" />

    <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8"
          IsEnabled="{Binding CanEditSettings}">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="NMEA input" Foreground="#DDD" VerticalAlignment="Center" />
      <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Inputs}"
                SelectedItem="{Binding SelectedInput}" HorizontalAlignment="Stretch" />
      <Button Grid.Row="0" Grid.Column="2" Content="Refresh" Command="{Binding RefreshInputsCommand}"
              Margin="6,0,0,0" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Baud" Foreground="#DDD" VerticalAlignment="Center"
                 IsVisible="{Binding IsSerialInput}" />
      <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Bauds}"
                SelectedItem="{Binding SelectedBaud}" HorizontalAlignment="Stretch"
                IsVisible="{Binding IsSerialInput}" />
    </Grid>

    <Grid ColumnDefinitions="120,*,120,*" IsVisible="{Binding !IsSerialInput}"
          IsEnabled="{Binding CanEditSettings}">
      <TextBlock Grid.Column="0" Text="Remote host" Foreground="#DDD" VerticalAlignment="Center"
                 IsVisible="{Binding IsNetworkClient}" />
      <TextBox Grid.Column="1" Text="{Binding NetworkHost}" IsVisible="{Binding IsNetworkClient}" />
      <TextBlock Grid.Column="2" Text="{Binding NetworkPortLabel}" Foreground="#DDD"
                 VerticalAlignment="Center" Margin="8,0,0,0" />
      <NumericUpDown Grid.Column="3" Value="{Binding NetworkPort}" Minimum="1" Maximum="65535"
                     Increment="1" FormatString="0" />
    </Grid>

    <Grid ColumnDefinitions="120,*,120,*" IsEnabled="{Binding CanEditSettings}">
      <TextBlock Grid.Column="0" Text="Update rate (Hz)" Foreground="#DDD" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Rates}" SelectedItem="{Binding UpdateRateHz}"
                HorizontalAlignment="Stretch" />
      <CheckBox Grid.Column="2" Grid.ColumnSpan="2" Content="Show relative altitude"
                IsChecked="{Binding ShowRelativeAltitude}" Margin="12,0,0,0" />
    </Grid>

    <CheckBox Content="Update vehicle rally point 0 every five seconds"
              IsChecked="{Binding UpdateRallyPoint}"
              IsEnabled="{Binding CanEditSettings}"
              ToolTip.Tip="Requires a connected vehicle with RALLY_TOTAL support. The rally altitude is base AMSL plus the planner default altitude." />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="ToggleMovingBaseButton" Content="{Binding ConnectButtonText}"
              Command="{Binding ToggleConnectCommand}" MinWidth="100" />
      <TextBlock Text="Raw NMEA is logged to MovingBase.txt in the user data directory."
                 Foreground="#888" VerticalAlignment="Center" />
    </StackPanel>

    <Border Background="{DynamicResource MpInputBg}" CornerRadius="4" Padding="10">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MpAccentBrush}"
                   TextWrapping="Wrap" />
        <TextBlock Text="Current base:" Foreground="#AAA" />
        <TextBlock Text="{Binding Location}" Foreground="#DDD" FontFamily="Consolas,monospace"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
