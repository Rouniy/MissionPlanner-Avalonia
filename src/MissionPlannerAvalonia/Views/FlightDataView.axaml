<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:MissionPlannerAvalonia.ViewModels"
  xmlns:views="using:MissionPlannerAvalonia.Views"
  xmlns:ctl="using:MissionPlannerAvalonia.Controls"
  xmlns:cv="using:MissionPlannerAvalonia.ViewModels.GCSViews.ConfigurationView"
  mc:Ignorable="d"
  d:DesignWidth="1100"
  d:DesignHeight="640"
  x:Class="MissionPlannerAvalonia.Views.FlightDataView"
  x:DataType="vm:FlightDataViewModel"
  Background="{DynamicResource MpControlBg}"
>
  <Grid x:Name="FlightDataLayoutGrid">
    <Grid.ColumnDefinitions>

      <ColumnDefinition Width="2*" MinWidth="240" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="3*" MinWidth="240" />
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="{Binding HudColumn}" RowDefinitions="*,4,*">
      <Border Grid.Row="0" Background="Black">
        <ctl:HudControl
          x:Name="Hud"
          Roll="{Binding Roll}"
          Pitch="{Binding Pitch}"
          Yaw="{Binding Yaw}"
          Alt="{Binding Alt}"
          AirSpeed="{Binding AirSpeed}"
          GroundSpeed="{Binding GroundSpeed}"
          VerticalSpeed="{Binding VerticalSpeed}"
          SatCount="{Binding SatCount}"
          GpsFixType="{Binding GpsFixType}"
          Armed="{Binding Armed}"
          PrearmOk="{Binding PrearmOk}"
          Mode="{Binding Mode}"
          BatteryVoltage="{Binding BatteryVoltage}"
          BatteryRemaining="{Binding BatteryRemaining}"
          OverlayEnabled="{Binding HudOverlayEnabled}"
          ShowIcons="{Binding HudShowIcons}"
          Russian="{Binding HudRussian}"
          BatteryCells="{Binding HudBatteryCells}"
          GroundBrown="{Binding HudGroundBrown}"
          SixteenByNine="{Binding HudSixteenByNine}"
          NavBearing="{Binding NavBearing}"
          CurrentAmps="{Binding BatCurrent}"
          CustomItemsText="{Binding HudCustomText}"
          WindDir="{Binding WindDir}"
          WindVel="{Binding WindVel}"
          Aoa="{Binding Aoa}"
          Ssa="{Binding Ssa}"
          XTrackError="{Binding XTrackError}"
          TurnRate="{Binding TurnRate}"
          WpDist="{Binding WpDist}"
          WpNo="{Binding WpNo}"
          BatteryVoltage2="{Binding BatteryVoltage2}"
          BatteryRemaining2="{Binding BatteryRemaining2}"
          CurrentAmps2="{Binding BatCurrent2}"
          ThrottlePercent="{Binding ThrottlePercent}"
          Failsafe="{Binding Failsafe}"
          SafetyActive="{Binding SafetyActive}"
          LinkQuality="{Binding LinkQuality}"
          TargetAlt="{Binding TargetAlt}"
          TargetSpeed="{Binding TargetSpeed}"
          DisplayHeading="{Binding HudHeading}"
          DisplaySpeed="{Binding HudSpeed}"
          DisplayAlt="{Binding HudAlt}"
          DisplayRollPitch="{Binding HudRollPitch}"
          DisplayGps="{Binding HudGps}"
          DisplayBattery="{Binding HudBattery}"
          DisplayBattery2="{Binding HudBattery2}"
          DisplayAoa="{Binding HudAoa}"
          DisplayXTrack="{Binding HudXTrack}"
          DisplayConnection="{Binding HudConnection}"
          DisplayEkf="{Binding HudEkf}"
          DisplayVibe="{Binding HudVibe}"
          DisplayPrearm="{Binding HudPrearm}"
        >
          <ctl:HudControl.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Video">
                <MenuItem Header="Record Video Stream" Command="{Binding RecordVideoCommand}" />
                <MenuItem Header="Stop Record" Command="{Binding StopVideoCommand}" />
                <MenuItem Header="Snapshot…" Command="{Binding SnapshotVideoCommand}" />
                <Separator />
                <MenuItem Header="MAVLink Camera Stream…"
                          Command="{Binding SelectMavlinkVideoStreamCommand}" />
                <MenuItem Header="Set MJPEG source" Command="{Binding SetVideoSourceCommand}"
                          CommandParameter="mjpeg" />
                <MenuItem Header="Start Camera" Command="{Binding SetVideoSourceCommand}"
                          CommandParameter="camera" />
                <MenuItem Header="Set GStreamer Source" Command="{Binding SetVideoSourceCommand}"
                          CommandParameter="gstreamer" />
                <MenuItem Header="HereLink Video" Command="{Binding SetVideoSourceCommand}"
                          CommandParameter="herelink" />
                <MenuItem Header="GStreamer Stop" Command="{Binding StopVideoCommand}" />
              </MenuItem>
              <MenuItem Header="Set Aspect Ratio" Command="{Binding ToggleHudAspectCommand}" />
              <MenuItem Header="User Items" Command="{Binding HudUserItemsCommand}" />
              <MenuItem Header="Russian Hud" ToggleType="CheckBox" IsChecked="{Binding HudRussian, Mode=TwoWay}" />
              <MenuItem Header="Swap With Map" Command="{Binding SwapHudMapCommand}" />
              <MenuItem Header="Ground Color" ToggleType="CheckBox" IsChecked="{Binding HudGroundBrown, Mode=TwoWay}" />
              <MenuItem Header="Battery Cell Voltage" Command="{Binding SetBatteryCellsCommand}" />
              <MenuItem Header="Show icons" ToggleType="CheckBox" IsChecked="{Binding HudShowIcons, Mode=TwoWay}" />
              <MenuItem Header="HUD Items">
                <MenuItem Header="Heading" ToggleType="CheckBox" IsChecked="{Binding HudHeading, Mode=TwoWay}" />
                <MenuItem Header="Speed" ToggleType="CheckBox" IsChecked="{Binding HudSpeed, Mode=TwoWay}" />
                <MenuItem Header="Alt" ToggleType="CheckBox" IsChecked="{Binding HudAlt, Mode=TwoWay}" />
                <MenuItem Header="Connection" ToggleType="CheckBox" IsChecked="{Binding HudConnection, Mode=TwoWay}" />
                <MenuItem Header="X-Track" ToggleType="CheckBox" IsChecked="{Binding HudXTrack, Mode=TwoWay}" />
                <MenuItem Header="Roll/Pitch" ToggleType="CheckBox" IsChecked="{Binding HudRollPitch, Mode=TwoWay}" />
                <MenuItem Header="GPS" ToggleType="CheckBox" IsChecked="{Binding HudGps, Mode=TwoWay}" />
                <MenuItem Header="Battery" ToggleType="CheckBox" IsChecked="{Binding HudBattery, Mode=TwoWay}" />
                <MenuItem Header="Battery2" ToggleType="CheckBox" IsChecked="{Binding HudBattery2, Mode=TwoWay}" />
                <MenuItem Header="EKF" ToggleType="CheckBox" IsChecked="{Binding HudEkf, Mode=TwoWay}" />
                <MenuItem Header="Vibe" ToggleType="CheckBox" IsChecked="{Binding HudVibe, Mode=TwoWay}" />
                <MenuItem Header="Prearm Status" ToggleType="CheckBox" IsChecked="{Binding HudPrearm, Mode=TwoWay}" />
                <MenuItem Header="AOA" ToggleType="CheckBox" IsChecked="{Binding HudAoa, Mode=TwoWay}" />
              </MenuItem>
            </ContextMenu>
          </ctl:HudControl.ContextMenu>
        </ctl:HudControl>
      </Border>

      <GridSplitter
        Grid.Row="1"
        Background="{DynamicResource MpBorderBrush}"
        ResizeDirection="Rows"
        ResizeBehavior="PreviousAndNext"
      />

      <TabControl
        x:Name="FdTabs"
        Grid.Row="2"
        Background="{DynamicResource MpControlBg}"
        SelectedIndex="{Binding SelectedActionTabIndex, Mode=TwoWay}"
      >
        <TabItem Header="Quick">
          <ItemsControl x:Name="QuickGrid" ItemsSource="{Binding QuickItems}" Margin="2"
                        DoubleTapped="OnQuickViewDoubleTapped">
            <ItemsControl.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Set View Count…" Command="{Binding ConfigureQuickViewLayoutCommand}"
                          IsVisible="{Binding QuickViewEditable}" />
              </ContextMenu>
            </ItemsControl.ContextMenu>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding $parent[ItemsControl].DataContext.QuickColumns}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QuickItem">
                <Border Classes="qv" Background="{Binding BackgroundBrush}">
                  <ctl:QuickView
                    Number="{Binding Number}"
                    Desc="{Binding Desc}"
                    NumberColor="{Binding Brush}"
                    DescriptionColor="{Binding LabelBrush}"
                  />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </TabItem>

        <TabItem Header="Actions">

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel Margin="6" Orientation="Horizontal">
              <WrapPanel.Styles>
                <Style Selector="WrapPanel > Panel">
                  <Setter Property="Width" Value="188" />
                  <Setter Property="Height" Value="34" />
                  <Setter Property="Margin" Value="3" />
                </Style>
                <Style Selector="WrapPanel > Button">
                  <Setter Property="Width" Value="188" />
                  <Setter Property="Height" Value="34" />
                  <Setter Property="MinHeight" Value="34" />
                  <Setter Property="Margin" Value="3" />
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="Panel Button">
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="VerticalAlignment" Value="Stretch" />
                  <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="Panel ComboBox">
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="VerticalAlignment" Value="Stretch" />
                </Style>
                <Style Selector="Panel NumericUpDown">
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="MinWidth" Value="0" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="VerticalAlignment" Value="Stretch" />
                </Style>
              </WrapPanel.Styles>

              <Panel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Width="78" Content="Set Mode"
                          Command="{Binding SetModeCommand}" />
                  <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                            HorizontalAlignment="Stretch" Margin="0,0,3,0" />
                </DockPanel>
              </Panel>
              <Panel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Width="78" Content="Set WP"
                          Command="{Binding SetWpCommand}" />
                  <ComboBox ItemsSource="{Binding WpNumbers}" SelectedItem="{Binding SelectedWaypoint}"
                            HorizontalAlignment="Stretch" Margin="0,0,3,0" />
                </DockPanel>
              </Panel>
              <Panel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Width="78" Content="Do Action"
                          Command="{Binding DoActionCommand}" />
                  <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}"
                            HorizontalAlignment="Stretch" Margin="0,0,3,0" />
                </DockPanel>
              </Panel>
              <Panel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Width="78" Content="Set Mount"
                          Command="{Binding SetMountCommand}" />
                  <ComboBox ItemsSource="{Binding MountModes}" SelectedItem="{Binding SelectedMountMode}"
                            HorizontalAlignment="Stretch" Margin="0,0,3,0" />
                </DockPanel>
              </Panel>

              <Panel>
                <DockPanel>
                  <NumericUpDown DockPanel.Dock="Right" Width="74" ShowButtonSpinner="False"
                                 FormatString="0.0" Value="{Binding ChangeSpeedValue}" />
                  <Button Content="Speed" Command="{Binding ChangeSpeedCommand}" Margin="0,0,3,0"
                          HorizontalAlignment="Stretch" />
                </DockPanel>
              </Panel>
              <Panel>
                <DockPanel>
                  <NumericUpDown DockPanel.Dock="Right" Width="74" ShowButtonSpinner="False"
                                 FormatString="0.0" Value="{Binding ChangeAltValue}" />
                  <Button Content="Alt" Command="{Binding ChangeAltCommand}" Margin="0,0,3,0"
                          HorizontalAlignment="Stretch" />
                </DockPanel>
              </Panel>
              <Panel>
                <DockPanel>
                  <NumericUpDown DockPanel.Dock="Right" Width="74" ShowButtonSpinner="False"
                                 FormatString="0" Value="{Binding LoiterRadValue}" />
                  <Button Content="Loiter Rad" Command="{Binding SetLoiterRadCommand}" Margin="0,0,3,0"
                          HorizontalAlignment="Stretch" />
                </DockPanel>
              </Panel>

              <Button Content="Auto" Command="{Binding QuickAutoCommand}" />
              <Button Content="RTL" Command="{Binding QuickRtlCommand}" />
              <Button Content="Loiter" Command="{Binding QuickLoiterCommand}" />
              <Button Content="Arm/ Disarm" Command="{Binding ToggleArmCommand}" />

              <Button Content="Restart Mission" Command="{Binding RestartMissionCommand}" />
              <Button Content="Resume Mission" Command="{Binding ResumeMissionCommand}" />
              <Button Content="Abort Landing" Command="{Binding AbortLandCommand}" />
              <Button Content="Set Home Alt" Command="{Binding SetHomeCommand}" />

              <Button Content="Raw Sensor View" Command="{Binding RawSensorViewCommand}" />
              <Button Content="Clear Track" Command="{Binding ClearTrackCommand}" />
              <Button Content="Message" Command="{Binding ShowMessageCommand}" />
              <Button Content="Disable Joystick" Command="{Binding JoystickCommand}"
                      ToolTip.Tip="Release active joystick control; configure it under Setup > Joystick" />

              <Panel Width="382">
                <Grid ColumnDefinitions="*,64,54,48,54" ColumnSpacing="3">
                  <ComboBox Grid.Column="0" ItemsSource="{Binding MessageOptions}"
                            SelectedItem="{Binding SelectedMessage}" />
                  <NumericUpDown Grid.Column="1" Minimum="0.01" Maximum="1000"
                                 Increment="1" FormatString="0.##"
                                 Value="{Binding MessageRateHz}"
                                 ToolTip.Tip="Requested MAVLink message rate in Hz" />
                  <Button Grid.Column="2" Content="Apply" Command="{Binding ApplyMessageIntervalCommand}" />
                  <Button Grid.Column="3" Content="Stop" Command="{Binding StopMessageIntervalCommand}" />
                  <Button Grid.Column="4" Content="Default" Command="{Binding ResetMessageIntervalCommand}" />
                </Grid>
              </Panel>
              <TextBlock Width="382" Margin="3" Text="{Binding MessageIntervalStatus}"
                         TextWrapping="Wrap" VerticalAlignment="Center" />
            </WrapPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Messages">
          <Grid Margin="4" RowDefinitions="Auto,2*,Auto,*" RowSpacing="3">
            <TextBlock Grid.Row="0" Text="Vehicle messages" FontWeight="SemiBold" />
            <TextBox
              Grid.Row="1"
              Text="{Binding StatusText, Mode=OneWay}"
              AcceptsReturn="True"
              IsReadOnly="True"
              TextWrapping="Wrap"
              Background="{DynamicResource MpBorderBrush}"
              Foreground="WhiteSmoke"
            />
            <TextBlock Grid.Row="2" Text="Ground-station actions" FontWeight="SemiBold" />
            <TextBox
              Grid.Row="3"
              Text="{Binding Messages, Mode=OneWay}"
              AcceptsReturn="True"
              IsReadOnly="True"
              TextWrapping="Wrap"
              Background="{DynamicResource MpBorderBrush}"
              Foreground="#9BD"
            />
          </Grid>
        </TabItem>

        <TabItem Header="Simple Actions">
          <Grid Margin="16" ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Button Grid.Column="0" Content="LOITER" FontSize="22" FontWeight="Bold"
                    Command="{Binding QuickLoiterCommand}"
                    ToolTip.Tip="Hold position / enter Loiter mode" />
            <Button Grid.Column="1" Content="RTL" FontSize="22" FontWeight="Bold"
                    Command="{Binding QuickRtlCommand}"
                    ToolTip.Tip="Return to launch" />
            <Button Grid.Column="2" Content="AUTO" FontSize="22" FontWeight="Bold"
                    Command="{Binding QuickAutoCommand}"
                    ToolTip.Tip="Continue the uploaded mission in Auto mode" />
          </Grid>
        </TabItem>

        <TabItem Header="PreFlight">
          <DockPanel Margin="6">
            <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="Edit" Width="60"
                    Command="{Binding EditPreflightCommand}"
                    IsVisible="{Binding PreflightEditVisible}" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding PreflightChecks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CheckItem">
                    <Grid ColumnDefinitions="*,120,28" Margin="0,2" Background="{DynamicResource MpPanelBg}">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="6,4"
                                 VerticalAlignment="Center" Foreground="{Binding Foreground}" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center"
                                 Foreground="{Binding Foreground}" />

                      <CheckBox Grid.Column="2" IsChecked="{Binding Ok, Mode=TwoWay}"
                                IsHitTestVisible="{Binding Manual}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <TabItem Header="Gauges">

          <Grid Margin="6" RowDefinitions="*,*" ColumnDefinitions="*,*">
            <ctl:Gauge x:Name="GVsi" Grid.Row="0" Grid.Column="0" Margin="6" MinHeight="120"
                       Label="VSI" Units="m/s" Min="-10" Max="10" Value="{Binding VerticalSpeed}"
                       DoubleTapped="OnGaugeDoubleTapped" />
            <ctl:Gauge x:Name="GSpeed" Grid.Row="0" Grid.Column="1" Margin="6" MinHeight="120"
                       Label="Speed" Units="m/s" Min="0" Max="60" Value="{Binding AirSpeed}"
                       Value2="{Binding GroundSpeed}" DoubleTapped="OnGaugeDoubleTapped"
                       IsVisible="{Binding AnemometerVisible}" />
            <ctl:Gauge x:Name="GAlt" Grid.Row="1" Grid.Column="0" Margin="6" MinHeight="120"
                       Label="Alt" Units="m" Min="0" Max="1000" Value="{Binding Alt}"
                       DoubleTapped="OnGaugeDoubleTapped" />
            <ctl:Hsi Grid.Row="1" Grid.Column="1" Margin="6" MinHeight="120"
                     Heading="{Binding Yaw}" NavHeading="{Binding NavBearing}"
                     WpDist="{Binding WpDist}" />
          </Grid>
        </TabItem>

        <TabItem Header="Transponder">
          <StackPanel Margin="10" Spacing="8">
            <Button Content="Connect to Transponder" HorizontalAlignment="Left"
                    Command="{Binding ConnectTransponderCommand}" />
            <TextBlock Text="{Binding TransponderStatus}" Foreground="{DynamicResource MpAccentBrush}" />
            <Grid ColumnDefinitions="Auto,160" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Squawk" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="7777"
                             Value="{Binding Squawk, Mode=TwoWay}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="FlightID" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" MaxLength="8" Text="{Binding FlightId, Mode=TwoWay}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="STBY" Width="60" Command="{Binding TransponderStandbyCommand}" />
              <Button Content="ALT" Width="60" Command="{Binding TransponderAltCommand}" />
              <Button Content="ON" Width="60" Command="{Binding TransponderOnCommand}" />
              <Button Content="IDENT" Width="60" Command="{Binding TransponderIdentCommand}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Mode" FontWeight="Bold" />
                <CheckBox Content="Mode A" IsChecked="{Binding ModeA, Mode=TwoWay}" />
                <CheckBox Content="Mode C" IsChecked="{Binding ModeC, Mode=TwoWay}" />
                <CheckBox Content="Mode S" IsChecked="{Binding ModeS, Mode=TwoWay}" />
                <CheckBox Content="1090ES ADS-B OUT" IsChecked="{Binding ModeEs, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Faults" FontWeight="Bold" />
                <CheckBox Content="Maint. Req." IsChecked="{Binding XpdrMaintReq}" IsHitTestVisible="False" />
                <CheckBox Content="GPS Unavail." IsChecked="{Binding XpdrGpsUnavailable}" IsHitTestVisible="False" />
                <CheckBox Content="GPS No Fix" IsChecked="{Binding XpdrGpsNoFix}" IsHitTestVisible="False" />
                <CheckBox Content="TX Sys. Fail." IsChecked="{Binding XpdrTxSystemFailure}" IsHitTestVisible="False" />
                <CheckBox Content="Airborne" IsChecked="{Binding XpdrAirborne}" IsHitTestVisible="False" />
              </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Text="{Binding XpdrNic, StringFormat='NIC: {0}'}" />
              <TextBlock Text="{Binding XpdrNacp, StringFormat='NACp: {0}'}" />
            </StackPanel>
          </StackPanel>
        </TabItem>

        <TabItem Header="Status">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Statuses}" Margin="6">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StatusItem">
                  <Grid Width="200" ColumnDefinitions="*,Auto" Margin="2,1">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#BBBBBB" FontSize="11" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Servo/Relay">

          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ServoRelayItems}" Margin="4">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical" Spacing="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="vm:ServoChannel">
                  <Grid ColumnSpacing="6" HorizontalAlignment="Left"
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <Border Grid.Column="0" Background="#5A5A5A" CornerRadius="3"
                            MinWidth="64" Padding="8,0">
                      <TextBlock Text="{Binding Label}" Foreground="White"
                                 FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button Grid.Column="1" Content="{Binding LowLabel}" MinWidth="52" FontSize="11" Padding="8,3"
                            Command="{Binding $parent[ItemsControl].((vm:FlightDataViewModel)DataContext).SetServoChannelCommand}"
                            CommandParameter="{Binding Number, StringFormat='{}{0}:low'}" />
                    <Button Grid.Column="2" Content="Mid" MinWidth="52" FontSize="11" Padding="8,3"
                            Command="{Binding $parent[ItemsControl].((vm:FlightDataViewModel)DataContext).SetServoChannelCommand}"
                            CommandParameter="{Binding Number, StringFormat='{}{0}:mid'}" />
                    <Button Grid.Column="3" Content="{Binding HighLabel}" MinWidth="52" FontSize="11" Padding="8,3"
                            Command="{Binding $parent[ItemsControl].((vm:FlightDataViewModel)DataContext).SetServoChannelCommand}"
                            CommandParameter="{Binding Number, StringFormat='{}{0}:high'}" />
                    <Button Grid.Column="4" Content="Toggle" MinWidth="64" FontSize="11" Padding="8,3"
                            Command="{Binding $parent[ItemsControl].((vm:FlightDataViewModel)DataContext).SetServoChannelCommand}"
                            CommandParameter="{Binding Number, StringFormat='{}{0}:toggle'}" />
                    <TextBox Grid.Column="5" Width="76" FontSize="11" Padding="4,2" Watermark="Min PWM"
                             ToolTip.Tip="Minimum PWM (µs)" Text="{Binding Min, Mode=TwoWay}" />
                    <TextBox Grid.Column="6" Width="76" FontSize="11" Padding="4,2" Watermark="Max PWM"
                             ToolTip.Tip="Maximum PWM (µs)" Text="{Binding Max, Mode=TwoWay}" />
                    <Button Grid.Column="7" Content="Names…" MinWidth="64" FontSize="11" Padding="8,3"
                            ToolTip.Tip="Rename this servo and its Low/High buttons"
                            Command="{Binding $parent[ItemsControl].((vm:FlightDataViewModel)DataContext).RenameServoChannelCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:RelayChannel">
                  <Grid ColumnSpacing="6" HorizontalAlignment="Left"
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <Border Grid.Column="0" Background="#5A5A5A" CornerRadius="3"
                            MinWidth="64" Padding="8,0">
                      <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button Grid.Column="1" Content="{Binding LowLabel}" MinWidth="52" FontSize="11" Padding="8,3"
                            Command="{Binding $parent[ItemsControl].((vm:FlightDataViewModel)DataContext).SetRelayCommand}"
                            CommandParameter="{Binding Index, StringFormat='{}{0}:low'}" />
                    <Button Grid.Column="2" Content="{Binding HighLabel}" MinWidth="52" FontSize="11" Padding="8,3"
                            Command="{Binding $parent[ItemsControl].((vm:FlightDataViewModel)DataContext).SetRelayCommand}"
                            CommandParameter="{Binding Index, StringFormat='{}{0}:high'}" />
                    <Button Grid.Column="3" Content="Toggle" MinWidth="64" FontSize="11" Padding="8,3"
                            Command="{Binding $parent[ItemsControl].((vm:FlightDataViewModel)DataContext).SetRelayCommand}"
                            CommandParameter="{Binding Index, StringFormat='{}{0}:toggle'}" />
                    <Button Grid.Column="4" Content="Names…" MinWidth="64" FontSize="11" Padding="8,3"
                            ToolTip.Tip="Rename this relay and its Low/High buttons"
                            Command="{Binding $parent[ItemsControl].((vm:FlightDataViewModel)DataContext).RenameRelayChannelCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Aux Function">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding AuxOptions}" Margin="6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AuxFunctionRow">
                  <Grid ColumnDefinitions="64,280,64,64,64,*" ColumnSpacing="6" Margin="0,2">
                    <Border Grid.Column="0" Background="#5A5A5A" CornerRadius="3">
                      <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Functions}"
                              SelectedItem="{Binding SelectedFunction, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />
                    <Button Grid.Column="2" Content="Low"
                            Command="{Binding $parent[ItemsControl].((vm:FlightDataViewModel)DataContext).SetAuxFunctionCommand}"
                            CommandParameter="{Binding Index, StringFormat='{}{0}:0'}" />
                    <Button Grid.Column="3" Content="Middle"
                            Command="{Binding $parent[ItemsControl].((vm:FlightDataViewModel)DataContext).SetAuxFunctionCommand}"
                            CommandParameter="{Binding Index, StringFormat='{}{0}:1'}" />
                    <Button Grid.Column="4" Content="High"
                            Command="{Binding $parent[ItemsControl].((vm:FlightDataViewModel)DataContext).SetAuxFunctionCommand}"
                            CommandParameter="{Binding Index, StringFormat='{}{0}:2'}" />
                    <TextBlock Grid.Column="5" Text="{Binding Status}" VerticalAlignment="Center"
                               Foreground="{DynamicResource MpAccentBrush}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Scripts">
          <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,*,Auto,*">
            <TextBlock Grid.Row="0" Text="{Binding ScriptStatus, StringFormat=Lua Script Status: {0}}"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="{Binding SelectedScript, StringFormat=Selected Lua Script: {0}}" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,4">
              <Button Content="Select Lua Script" Command="{Binding SelectScriptCommand}" />
              <Button Content="Edit Selected" Command="{Binding EditScriptCommand}"
                      IsVisible="{Binding ScriptSelected}" />
              <Button Content="Run" Command="{Binding RunScriptCommand}" />
              <Button Content="Abort" Command="{Binding AbortScriptCommand}" />
            </StackPanel>
            <TextBox Grid.Row="3" Text="{Binding ScriptEditorText}" AcceptsReturn="True"
                     AcceptsTab="True" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                     Background="{DynamicResource MpBorderBrush}" Foreground="WhiteSmoke"
                     Watermark="Lua code (leave empty to run the selected file)" />
            <TextBlock Grid.Row="4" Text="Output" Margin="0,6,0,2" />
            <TextBox Grid.Row="5" Text="{Binding ScriptOutput}" AcceptsReturn="True" IsReadOnly="True"
                     TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                     Background="{DynamicResource MpBorderBrush}" Foreground="#9BD" />
          </Grid>
        </TabItem>

        <TabItem Header="Payload Control">
          <Grid Margin="10" ColumnDefinitions="Auto,*" RowDefinitions="*">
            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,20,0">
              <TextBlock Text="Tilt" HorizontalAlignment="Center" />
              <Slider Orientation="Vertical" Height="160" Minimum="-90" Maximum="45"
                      Value="{Binding Tilt, Mode=TwoWay}" HorizontalAlignment="Center" />
              <Button Content="Reset Position" FontSize="11" Command="{Binding ResetPositionCommand}" />
              <Button Content="Open Video Stream…" FontSize="11"
                      Command="{Binding SetVideoSourceCommand}" CommandParameter="custom" />
              <Button Content="Trigger Camera" FontSize="11" Command="{Binding TriggerCameraCommand}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Top">
              <StackPanel Spacing="2">
                <TextBlock Text="Pan" />
                <Slider Minimum="-180" Maximum="180" Value="{Binding Pan, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="Roll" />
                <Slider Minimum="-90" Maximum="90" Value="{Binding Roll2, Mode=TwoWay}" />
              </StackPanel>
              <Border BorderBrush="{DynamicResource MpBorderBrush}" BorderThickness="1"
                      CornerRadius="4" Padding="8">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding CameraTarget, StringFormat=MAVLink camera: {0}}"
                             TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button Content="Take Photo" Margin="0,0,6,0"
                            Command="{Binding TakeMavlinkPhotoCommand}" />
                    <Button Content="Start Recording" Margin="0,0,6,0"
                            Command="{Binding StartMavlinkCameraRecordingCommand}" />
                    <Button Content="Stop Recording"
                            Command="{Binding StopMavlinkCameraRecordingCommand}" />
                  </WrapPanel>
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="Zoom" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="100"
                            Value="{Binding CameraZoom, Mode=TwoWay}" />
                    <Button Grid.Column="2" Content="Set"
                            Command="{Binding SetMavlinkCameraZoomCommand}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </TabItem>

        <TabItem Header="Telemetry Logs">
          <Grid Margin="8" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="6" RowSpacing="6">
            <Button Grid.Row="0" Grid.Column="0" Content="Load Log" HorizontalAlignment="Stretch"
                    Command="{Binding LoadTlogCommand}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LogStatus}" Foreground="#C8A03C"
                       VerticalAlignment="Center" TextWrapping="Wrap" />

            <Button Grid.Row="1" Grid.Column="0" Content="Play/Pause" HorizontalAlignment="Stretch"
                    Command="{Binding PlayPauseTlogCommand}" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100"
                    Value="{Binding TlogProgress, Mode=TwoWay}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TlogPositionText}"
                       VerticalAlignment="Center" />

            <Button Grid.Row="2" Grid.Column="0" Content="Tlog > Kml or Graph"
                    HorizontalAlignment="Stretch" Command="{Binding TlogToKmlCommand}" />
            <WrapPanel Grid.Row="2" Grid.Column="1">
              <Button Content="10x" Margin="1" MinWidth="36"
                      Command="{Binding SetTlogSpeedCommand}" CommandParameter="10" />
              <Button Content="5x" Margin="1" MinWidth="36"
                      Command="{Binding SetTlogSpeedCommand}" CommandParameter="5" />
              <Button Content="2x" Margin="1" MinWidth="36"
                      Command="{Binding SetTlogSpeedCommand}" CommandParameter="2" />
              <Button Content="1x" Margin="1" MinWidth="36"
                      Command="{Binding SetTlogSpeedCommand}" CommandParameter="1" />
              <Button Content="0.5" Margin="1" MinWidth="36"
                      Command="{Binding SetTlogSpeedCommand}" CommandParameter="0.5" />
              <Button Content="0.25" Margin="1" MinWidth="36"
                      Command="{Binding SetTlogSpeedCommand}" CommandParameter="0.25" />
              <Button Content="0.1" Margin="1" MinWidth="36"
                      Command="{Binding SetTlogSpeedCommand}" CommandParameter="0.1" />
            </WrapPanel>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding PlaybackSpeedText}"
                       VerticalAlignment="Center" />
          </Grid>
        </TabItem>

        <TabItem Header="DataFlash Logs">
          <Grid Margin="8" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="4" RowSpacing="4">
            <Button Grid.Row="0" Grid.Column="0" Content="Download DataFlash Log Via Mavlink"
                    HorizontalAlignment="Stretch" Command="{Binding DownloadDataflashLogCommand}" />
            <Button Grid.Row="0" Grid.Column="1" Content="Review a Log" HorizontalAlignment="Stretch"
                    Command="{Binding ReviewLogCommand}" />
            <Button Grid.Row="0" Grid.Column="2" Content="Auto Analysis" HorizontalAlignment="Stretch"
                    Command="{Binding AutoAnalysisCommand}" />

            <Button Grid.Row="1" Grid.Column="0" Content="Create KML + gpx" HorizontalAlignment="Stretch"
                    Command="{Binding CreateKmlGpxCommand}" />
            <Button Grid.Row="1" Grid.Column="1" Content="Convert Bin to Log" HorizontalAlignment="Stretch"
                    Command="{Binding ConvertBinToLogCommand}" />
            <Button Grid.Row="1" Grid.Column="2" Content="Create Matlab File" HorizontalAlignment="Stretch"
                    Command="{Binding CreateMatlabCommand}" />

            <Button Grid.Row="2" Grid.Column="0" Content="Geo Reference Images" HorizontalAlignment="Stretch"
                    Command="{Binding GeoReferenceImagesCommand}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LogStatus}"
                       Foreground="#C8A03C" TextWrapping="Wrap" VerticalAlignment="Center" />

            <Button Grid.Row="3" Grid.Column="0" Content="Organize tlog/rlog/bin/log"
                    HorizontalAlignment="Stretch" Command="{Binding OrganizeLogsCommand}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="Sort local logs by vehicle type, system id and board serial number."
                       Foreground="#999999" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
        </TabItem>

      </TabControl>
    </Grid>

    <GridSplitter
      x:Name="MainFlightSplitter"
      Grid.Column="1"
      Background="{DynamicResource MpBorderBrush}"
      ResizeDirection="Columns"
      ResizeBehavior="PreviousAndNext"
      DragCompleted="OnMainSplitterDragCompleted"
    />

    <Border Grid.Column="{Binding MapColumn}" Background="{DynamicResource MpBg}" ClipToBounds="True">
      <Grid>
        <ctl:MapView x:Name="FdMap" />

        <StackPanel Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
          <CheckBox Content="Auto Pan" IsChecked="{Binding AutoPan}" Foreground="White" />
          <Button Content="Clear Track" Command="{Binding ClearTrackCommand}" Padding="6,2" />
          <CheckBox Content="Tuning" IsChecked="{Binding Tuning}" Foreground="White" />
          <Button Content="Pick…" Click="OnTuningPickClick" Padding="6,2" />
        </StackPanel>

        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                Background="#99000000" CornerRadius="4" Padding="6,3">
          <StackPanel Spacing="1">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Foreground="White" Text="{Binding SatCount, StringFormat='Sats: {0}'}" />
              <TextBlock Foreground="White" Text="{Binding GpsHdop, StringFormat='hdop: {0:0.0}'}" />
              <TextBlock Foreground="White" IsVisible="{Binding ShowDistanceToHome}"
                         Text="{Binding DistToHome, StringFormat='Home: {0:0} m'}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Foreground="White" Text="{Binding GroundSpeed, StringFormat='GS: {0:0.0} m/s'}" />
              <TextBlock Foreground="White"
                         Text="{Binding WindDir, StringFormat='Wind: {0:0}°'}" />
              <TextBlock Foreground="White" Text="{Binding WindVel, StringFormat='{}{0:0.0} m/s'}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Foreground="#CCCCCC" FontSize="11"
                         Text="{Binding CursorLat, StringFormat='Cursor: {0:0.000000}, '}" />
              <TextBlock Foreground="#CCCCCC" FontSize="11"
                         Text="{Binding CursorLng, StringFormat='{}{0:0.000000}'}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Width="430"
                Background="#99000000" CornerRadius="4" Padding="7,4">
          <StackPanel Spacing="2">
            <TextBlock Foreground="White" FontSize="11" Text="{Binding MissionProgressText}"
                       TextTrimming="CharacterEllipsis" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding MissionProgress}" Height="7" />
            <TextBlock HorizontalAlignment="Right" Foreground="#CCCCCC" FontSize="9"
                       Text="GPS track: yellow" />
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding Tuning}" VerticalAlignment="Bottom" Height="210"
                Margin="0,0,0,26" Background="#CC1B1B1B">
          <ctl:LivePlot x:Name="TuningPlot" DoubleTapped="OnTuningPickClick" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
