<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>MissionPlannerAvalonia</AssemblyName>
    <RootNamespace>MissionPlannerAvalonia</RootNamespace>
    <ApplicationIcon>Assets/appicon.ico</ApplicationIcon>
    <!-- Keep the product version aligned with the exact official MissionPlanner source pinned
         by the submodule. Release/package scripts pass the build date and short port commit;
         ordinary developer builds get today's local date and the SDK-provided full Git revision. -->
    <MissionPlannerVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../external/MissionPlanner/Properties/AssemblyInfo.cs'))</MissionPlannerVersionFile>
    <MissionPlannerVersionFileExists>$([System.IO.File]::Exists('$(MissionPlannerVersionFile)'))</MissionPlannerVersionFileExists>
    <MissionPlannerUpstreamVersion Condition="'$(MissionPlannerUpstreamVersion)' == '' And '$(MissionPlannerVersionFileExists)' == 'True'">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MissionPlannerVersionFile)')), 'AssemblyFileVersion\(&quot;([0-9]+\.[0-9]+\.[0-9]+)&quot;\)').Groups[1].Value)</MissionPlannerUpstreamVersion>
    <MissionPlannerUpstreamVersion Condition="'$(MissionPlannerUpstreamVersion)' == ''">0.0.0</MissionPlannerUpstreamVersion>
    <MissionPlannerBuildDate Condition="'$(MissionPlannerBuildDate)' == ''">$([System.DateTime]::Now.ToString('yyyyMMdd'))</MissionPlannerBuildDate>
    <Version>$(MissionPlannerUpstreamVersion)</Version>
    <AssemblyVersion>$(MissionPlannerUpstreamVersion).0</AssemblyVersion>
    <FileVersion>$(MissionPlannerUpstreamVersion).0</FileVersion>
    <InformationalVersion>$(MissionPlannerUpstreamVersion)+$(MissionPlannerBuildDate)</InformationalVersion>
    <InformationalVersion Condition="'$(MissionPlannerCommit)' != ''">$(MissionPlannerUpstreamVersion)+$(MissionPlannerBuildDate).$(MissionPlannerCommit)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion Condition="'$(MissionPlannerCommit)' != ''">false</IncludeSourceRevisionInInformationalVersion>
    <!-- Keep PublishAot local to the executable project. Passing PublishAot on the
         command line propagates it to the netstandard2.0 upstream projects. -->
    <PublishAot Condition="'$(EnableNativeAot)' == 'true'">true</PublishAot>
  </PropertyGroup>

  <Target Name="ValidateMissionPlannerVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(MissionPlannerVersionFileExists)' != 'True'"
           Text="Pinned MissionPlanner source is missing. Run: git submodule update --init external/MissionPlanner" />
    <Error Condition="'$(MissionPlannerUpstreamVersion)' == '0.0.0'"
           Text="Could not read AssemblyFileVersion x.y.z from $(MissionPlannerVersionFile)." />
  </Target>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <!-- VideoLAN.LibVLC.Windows enables all three architectures for AnyCPU unless
         told otherwise. A win-x64 artifact only needs the x64 runtime. -->
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Mapsui.Avalonia" />
    <PackageReference Include="Mapsui.Tiling" />
    <PackageReference Include="Mapsui.Nts" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Projektanker.Icons.Avalonia" />
    <PackageReference Include="Projektanker.Icons.Avalonia.FontAwesome" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="HidSharp" />
    <PackageReference Include="Linux.Bluetooth" />
    <!-- Linux.Bluetooth declares 0.20.0; pin the compatible reflection API to the first
         CVE-2026-39959-fixed release instead of accepting the vulnerable transitive version. -->
    <PackageReference Include="Tmds.DBus" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="ScottPlot.Avalonia" />
    <PackageReference Include="MoonSharp" />
    <PackageReference Include="LibVLCSharp.Avalonia" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="MetadataExtractor" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="NetTopologySuite.IO.Esri.Shapefile" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>

  <PropertyGroup>
    <MacVlcRid Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or
                              '$(RuntimeIdentifier)' == 'osx-arm64'">$(RuntimeIdentifier)</MacVlcRid>
    <MacVlcRid Condition="'$(MacVlcRid)' == '' And
                              $([MSBuild]::IsOSPlatform('OSX'))">$(NETCoreSdkPortableRuntimeIdentifier)</MacVlcRid>
    <MacVlcRuntimeDir Condition="'$(MacVlcRid)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)vlc/$(MacVlcRid)'))</MacVlcRuntimeDir>
    <SimpleBleMacRid Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or
                                    '$(RuntimeIdentifier)' == 'osx-arm64'">$(RuntimeIdentifier)</SimpleBleMacRid>
    <SimpleBleMacRid Condition="'$(SimpleBleMacRid)' == '' And
                                    $([MSBuild]::IsOSPlatform('OSX'))">$(NETCoreSdkPortableRuntimeIdentifier)</SimpleBleMacRid>
    <SimpleBleMacNativeDir Condition="'$(SimpleBleMacRid)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)simpleble/$(SimpleBleMacRid)'))</SimpleBleMacNativeDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(SimpleBleMacRid)' != ''">
    <Content Include="$(SimpleBleMacNativeDir)/libsimpleble-c.dylib" Link="libsimpleble-c.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(SimpleBleMacNativeDir)/libsimpleble.0.dylib" Link="libsimpleble.0.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../../LICENSES/SimpleBLE-0.7.3-NOTICE.txt"
             Link="LICENSES/SimpleBLE-0.7.3-NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../../LICENSES/VLC-3.0.23-NOTICE.txt"
             Link="LICENSES/VLC-3.0.23-NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="FetchMacVlc"
          BeforeTargets="PrepareForBuild"
          Condition="'$(MacVlcRid)' != ''">
    <Error Condition="'$(MacVlcRid)' != 'osx-x64' And
                      '$(MacVlcRid)' != 'osx-arm64'"
           Text="Unsupported macOS VLC runtime identifier: $(MacVlcRid)" />
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/vlc/fetch-macos.sh&quot; &quot;$(MacVlcRid)&quot; &quot;$(MacVlcRuntimeDir)&quot;" />
  </Target>

  <!-- The runtime file set is generated by FetchMacVlc, so collect it at target execution time
       rather than during initial project evaluation. Link preserves VLC's original sibling
       lib/plugins/share layout in build output, publish output and the final .app bundle. -->
  <Target Name="CollectMacVlcRuntime"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="FetchMacVlc"
          Condition="'$(MacVlcRid)' != ''">
    <ItemGroup>
      <_MacVlcLib Include="$(MacVlcRuntimeDir)/lib/**/*" />
      <_MacVlcPlugins Include="$(MacVlcRuntimeDir)/plugins/**/*" />
      <_MacVlcLua Include="$(MacVlcRuntimeDir)/share/lua/**/*" />
      <_MacVlcHrtfs Include="$(MacVlcRuntimeDir)/share/hrtfs/**/*" />

      <Content Include="@(_MacVlcLib)">
        <Link>lib/%(_MacVlcLib.RecursiveDir)%(_MacVlcLib.Filename)%(_MacVlcLib.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="@(_MacVlcPlugins)">
        <Link>plugins/%(_MacVlcPlugins.RecursiveDir)%(_MacVlcPlugins.Filename)%(_MacVlcPlugins.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="@(_MacVlcLua)">
        <Link>share/lua/%(_MacVlcLua.RecursiveDir)%(_MacVlcLua.Filename)%(_MacVlcLua.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="@(_MacVlcHrtfs)">
        <Link>share/hrtfs/%(_MacVlcHrtfs.RecursiveDir)%(_MacVlcHrtfs.Filename)%(_MacVlcHrtfs.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <Target Name="FetchMacSimpleBle"
          BeforeTargets="PrepareForBuild"
          Condition="'$(SimpleBleMacRid)' != ''">
    <Error Condition="'$(SimpleBleMacRid)' != 'osx-x64' And
                      '$(SimpleBleMacRid)' != 'osx-arm64'"
           Text="Unsupported macOS SimpleBLE runtime identifier: $(SimpleBleMacRid)" />
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/simpleble/fetch-macos.sh&quot; &quot;$(SimpleBleMacRid)&quot; &quot;$(SimpleBleMacNativeDir)&quot;" />
  </Target>

  <ItemGroup>

    <Compile Include="../../external/MissionPlanner/Radio/Uploader.cs" Link="Radio/Uploader.cs" />
    <Compile Include="../../external/MissionPlanner/Radio/IHex.cs" Link="Radio/IHex.cs" />
    <Compile Include="../../external/MissionPlanner/Grid/GridData.cs" Link="Grid/GridData.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../external/MissionPlanner/ExtLibs/ArduPilot/MissionPlanner.ArduPilot.csproj" />
    <ProjectReference Include="../../external/MissionPlanner/ExtLibs/alglibnet/alglibnet.csproj" />
    <ProjectReference Include="../../external/MissionPlanner/ExtLibs/DroneCAN/DroneCAN.csproj" />
    <ProjectReference Include="../MissionPlannerAvalonia.LegacyPluginApi/MissionPlannerAvalonia.LegacyPluginApi.csproj">
      <Aliases>LegacyPluginContract</Aliases>
    </ProjectReference>
    <ProjectReference Include="../MissionPlannerAvalonia.PluginApi/MissionPlannerAvalonia.PluginApi.csproj" />
    <ProjectReference Include="../Px4Uploader/Px4Uploader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../external/MissionPlanner/ParameterMetaDataBackup.xml" Link="ParameterMetaDataBackup.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../external/MissionPlanner/mavcmd.xml" Link="mavcmd.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../external/MissionPlanner/ParameterFactMetaData.xml" Link="ParameterFactMetaData.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../external/MissionPlanner/APMotorLayout.json" Link="APMotorLayout.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../external/MissionPlanner/camerasBuiltin.xml" Link="camerasBuiltin.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../external/MissionPlanner/checklistDefault.xml" Link="checklistDefault.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../external/MissionPlanner/airports.csv" Link="airports.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../../external/MissionPlanner/block_plane_0.dae" Link="block_plane_0.dae">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../external/MissionPlanner/graphs/*.xml" Link="graphs/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MissionPlannerAvalonia.Tests" />
  </ItemGroup>

  <Target Name="RemoveWindowsNativeBinariesFromNonWindowsPublish"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or
                     '$(RuntimeIdentifier)' == 'osx-x64' Or
                     '$(RuntimeIdentifier)' == 'osx-arm64' Or
                     ('$(RuntimeIdentifier)' == '' And
                      !$([MSBuild]::IsOSPlatform('Windows')))">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'libusb-1.0.dll' Or
                                        '%(Filename)%(Extension)' == 'simpleble-c.dll' Or
                                        '%(Filename)%(Extension)' == 'simpleble.dll'" />
    </ItemGroup>
  </Target>
</Project>
